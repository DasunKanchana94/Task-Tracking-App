// Flowline — Prisma schema
// Mirrors the database design in docs/PRODUCT_DESIGN_DOCUMENT.md (Section 5).
// Built incrementally across milestones; this file always reflects the
// full target schema so relations stay consistent as features land.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (NextAuth.js / Auth.js v5 Prisma adapter models + app-specific fields)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  passwordHash  String? // null when the account only uses OAuth
  avatarUrl     String?
  image         String? // mirrors avatarUrl for NextAuth compatibility

  timezone     String @default("UTC")
  locale       String @default("en-US")
  weekStartDay Int    @default(0) // 0 = Sunday
  timeFormat   Int    @default(24) // 12 | 24
  theme        String @default("default")
  colorMode    String @default("system") // light | dark | system

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     Account[]
  sessions     Session[]
  tasks        Task[]
  tags         Tag[]
  timeBlocks   TimeBlock[]
  recurrences  Recurrence[]
  habits       Habit[]
  dayTemplates DayTemplate[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Tasks (core CRUD; tags/projects/recurrence/timeblocks land in later milestones)
// ---------------------------------------------------------------------------

enum TaskStatus {
  pending
  in_progress
  completed
  cancelled
}

model Task {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentTaskId String?
  parentTask   Task?   @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]  @relation("TaskSubtasks")

  tags       TaskTag[]
  timeBlocks TimeBlock[]

  recurrenceId             String?
  recurrence               Recurrence?           @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  recurrenceInstanceDate   DateTime?             @db.Date
  recurrenceExceptionLinks RecurrenceException[] @relation("RecurrenceExceptionModifiedTask")

  title            String
  descriptionRich  Json?
  status           TaskStatus @default(pending)
  priority         Int        @default(0) // 0 none, 1 low, 2 med, 3 high, 4 urgent
  dueDate          DateTime?  @db.Date
  dueTime          String? // "HH:mm", stored as text to avoid timezone-laden DateTime
  estimatedMinutes Int?
  actualMinutes    Int        @default(0)
  icon             String?
  emoji            String?
  sortOrder        Float      @default(0)
  starred          Boolean    @default(false)
  completedAt      DateTime?
  deletedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, dueDate])
  @@index([parentTaskId])
  @@index([userId, status])
  @@index([userId, deletedAt])
  @@index([userId, starred])
  @@index([recurrenceId])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// Tags (Milestone 3: Subtasks & Tags)
// ---------------------------------------------------------------------------

model Tag {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String
  color String?
  emoji String?

  tasks TaskTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@map("tags")
}

model TaskTag {
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
  @@map("task_tags")
}

// ---------------------------------------------------------------------------
// Time Blocks (Milestone 4: Timeline Foundation, read-only)
// ---------------------------------------------------------------------------

model TimeBlock {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  title   String?
  startAt DateTime
  endAt   DateTime
  allDay  Boolean  @default(false)
  color   String?
  source  String   @default("local") // local | google | ics

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startAt, endAt])
  @@index([taskId])
  @@map("time_blocks")
}

// ---------------------------------------------------------------------------
// Recurring Tasks & RRULE Engine (Milestone 7)
// ---------------------------------------------------------------------------

enum RecurrenceExceptionAction {
  skip
  modified
}

model Recurrence {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  rrule     String // RFC5545 RRULE string, e.g. "FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR"
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  endCount  Int?
  timezone  String    @default("UTC")

  // Snapshot of the fields copied onto each generated task instance.
  taskTemplate Json

  tasks      Task[]
  exceptions RecurrenceException[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("recurrences")
}

model RecurrenceException {
  id           String     @id @default(uuid())
  recurrenceId String
  recurrence   Recurrence @relation(fields: [recurrenceId], references: [id], onDelete: Cascade)

  exceptionDate DateTime                  @db.Date
  action        RecurrenceExceptionAction

  modifiedTaskId String?
  modifiedTask   Task?   @relation("RecurrenceExceptionModifiedTask", fields: [modifiedTaskId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([recurrenceId, exceptionDate])
  @@map("recurrence_exceptions")
}

// ---------------------------------------------------------------------------
// Habits (Milestone 8: daily check-in, streaks, heatmap)
// ---------------------------------------------------------------------------

enum HabitFrequency {
  daily
  weekdays
  weekly
}

model Habit {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name              String
  emoji             String?
  color             String?
  frequency         HabitFrequency @default(daily)
  targetDaysPerWeek Int? // used when frequency = weekly
  archivedAt        DateTime?

  logs HabitLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("habits")
}

model HabitLog {
  id      String @id @default(uuid())
  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)

  date DateTime @db.Date // the calendar day being logged (UTC midnight)
  note String?

  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([habitId, date])
  @@map("habit_logs")
}

// ---------------------------------------------------------------------------
// Day Templates (Milestone 10: snapshot a day's blocks, apply to another date)
// ---------------------------------------------------------------------------

model DayTemplate {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String

  // Snapshot of that day's blocks: [{ title, taskTitle, startMinute, endMinute, color }]
  blocks Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("day_templates")
}
