# ---------------------------------------------------------------------------
# Database (Supabase Postgres, or local docker-compose Postgres for dev)
# ---------------------------------------------------------------------------
# Pooled connection string (used by the app at runtime).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flowline?schema=public"
# Direct (non-pooled) connection string, used by `prisma migrate`.
# When using Supabase, this points at port 5432 while DATABASE_URL uses the
# pgbouncer pooler on port 6543.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/flowline?schema=public"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# ---------------------------------------------------------------------------
# Generate with: npx auth secret   (or `openssl rand -base64 32`)
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shared secret checked against the Authorization header on /api/cron/*
# routes. Vercel Cron sends this automatically when set as a Vercel env var.
CRON_SECRET="replace-with-a-random-secret"

# ---------------------------------------------------------------------------
# Supabase Storage (used from later milestones for attachments)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
